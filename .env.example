# KosMatch v2 Environment Configuration Template
# Copy this file to .env.local for local development.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL + PostGIS (Hosted directly on Tencent Cloud Lighthouse VPS)
# Default standard connection: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://kosmatch:your_secure_password@localhost:5432/kosmatch

# Routing & Commute Services (OpenRouteService API key optional for real-time live routing fallback)
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key

# Google OAuth 2.0 (Google Identity Services)
# Buat OAuth 2.0 Client ID Web Application di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
