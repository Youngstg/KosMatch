# KosMatch v2 Environment Configuration Template
# Copy this file to .env.local for local development.

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (PostgreSQL + PostGIS + pgvector + Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend & ETL Direct Connection (for osm2pgsql / migrations / keep-alive)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Routing & Geocoding (Fase 1+)
OPENROUTESERVICE_API_KEY=your-openrouteservice-api-key
